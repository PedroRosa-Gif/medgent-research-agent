# MedGent backend environment configuration.
# Copy this file to `.env` and fill in values as needed.
# `.env` is gitignored; this `.env.example` is committed. Never commit real secrets.

# Which LLM provider to use: "ollama" (default, local), "groq", or "gemini".
LLM_PROVIDER=ollama

# Ollama connection (only used when LLM_PROVIDER=ollama). Defaults shown below.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Optional: Groq API key — only needed when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Optional: Google Gemini API key — only needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional: NCBI Entrez (PubMed) API key — raises request rate limits.
NCBI_API_KEY=

# Optional: LangSmith API key — enables tracing/observability.
LANGSMITH_API_KEY=
