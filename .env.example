# Root env for docker-compose (distinct from backend/.env.example).
# Copy to `.env` to override compose defaults. `.env` is gitignored.

# Model that `docker compose up` auto-pulls into the Ollama container.
# Default is qwen2.5:7b (~4.7 GB). For low-RAM machines use the lighter:
#   OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL=qwen2.5:7b
