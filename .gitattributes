# Normalize line endings across platforms.
# Treat all text files as text and store them with LF in the repository,
# which keeps diffs stable between Windows (CRLF) and Linux/macOS (LF) — e.g.
# this Windows dev machine and the Ubuntu CI runner.
* text=auto eol=lf

# Lockfiles and common text formats: always LF.
*.lock   text eol=lf
*.py     text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf

# Windows-specific scripts keep CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files: never touch.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.pdf    binary
*.ico    binary
